# Overrides, these are manual overrides to versions. Will take presedence over other checks.
# example override: OVERRIDE_KEDA_VERSION=2.17.3 # CVE-2025-68476 fix (CVSS 8.2, HIGH) - Helm chart only has 2.17.1

# Development tools
GOLANGCI_LINT_VERSION=v2.9.0
CONTROLLER_TOOLS_VERSION=v0.21.0
# ENVTEST_VERSION is derived in the Makefile from the sigs.k8s.io/controller-runtime
# version in go.mod. Set it here only to override that.
YQ_VERSION=v4.52.1
HELM_VERSION=v3.16.3
KUSTOMIZE_VERSION=v5.8.1
HELM_DOCS_VERSION=v1.12.0
POETRY_VERSION=1.8.3
UV_VERSION=0.7.8
RUFF_VERSION=0.14.13
SHELLCHECK_VERSION=v0.11.0
CODESPELL_VERSION=2.4.3
PINACT_VERSION=v3.9.0
KIND_VERSION=v0.30.0

# Runtime dependency: cert-manager issues the webhook certificate.
CERT_MANAGER_VERSION=v1.17.0
# Released version of the images and charts.
LOCALMODELCACHE_VERSION=v0.2.0
